POSTGRES_DB=ble_booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# Key for signing access tokens (at least 32 characters)
JWT_SECRET=change_me_to_a_random_value_of_32_chars
# Dev user password (only used in dev profile)
DEV_USER_PASSWORD=change_me_in_dev_profile_only
# CORS allowed origins for web frontend (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Booking emails (see backend/README.md). Locally: Mailpit from docker-compose, UI http://localhost:8025
APP_MAIL_ENABLED=true
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
APP_MAIL_FROM=no-reply@ble-booking.local
# Only for a real SMTP provider, Mailpit needs no login
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
